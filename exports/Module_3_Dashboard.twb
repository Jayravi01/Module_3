            <column caption='Checked On' datatype='string' name='[Calculation_3500000000000011]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Last Checked]) THEN &apos;-&apos; ELSE STR(YEAR([Last Checked])) + &apos;-&apos; + RIGHT(&apos;0&apos; + STR(MONTH([Last Checked])), 2) + &apos;-&apos; + RIGHT(&apos;0&apos; + STR(DAY([Last Checked])), 2) END' />
            </column>
            <column caption='Status Order' datatype='integer' name='[Calculation_3500000000000012]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Status] WHEN &apos;Scrape blocked&apos; THEN 1 WHEN &apos;Unavailable&apos; THEN 2 WHEN &apos;Not checked yet&apos; THEN 3 ELSE 4 END' />
            </column>
            <column datatype='date' name='[Last Checked]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Priority]' role='dimension' type='nominal' />
            <column datatype='string' name='[Source Link]' role='dimension' type='nominal' />
