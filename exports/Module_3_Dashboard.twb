        <title>
          <formatted-text>
            <run bold='true' fontcolor='#333333' fontname='Tableau Book' fontsize='16'>Changes feed</run>
            <run fontname='Tableau Book'>Æ&#10;</run>
            <run fontcolor='#7f7f7f' fontname='Tableau Book' fontsize='10'>Every baseline and change, newest first. Basis: stated = in the source text, inferred = by the monitor. Click a row to open the source page.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Visa records (RDS)' name='federated.0y64zqi00w4er512c9hi91q82ite' />
          </datasources>
          <datasource-dependencies datasource='federated.0y64zqi00w4er512c9hi91q82ite'>
            <column caption='Feed Date' datatype='string' name='[Calculation_3500000000000001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([Record Date])) + &apos;-&apos; + RIGHT(&apos;0&apos; + STR(MONTH([Record Date])), 2) + &apos;-&apos; + RIGHT(&apos;0&apos; + STR(DAY([Record Date])), 2)' />
            </column>
            <column caption='Effective (basis)' datatype='string' name='[Calculation_3500000000000002]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Effective Date]) OR [Effective Date] = &apos;&apos; THEN &apos;not stated&apos; ELSE [Effective Date] + &apos; (&apos; + [Effective Date Basis] + &apos;)&apos; END' />
            </column>
            <column caption='Visa (basis)' datatype='string' name='[Calculation_3500000000000003]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Visa Categories Affected]) OR [Visa Categories Affected] = &apos;&apos; THEN &apos;General&apos; ELSE [Visa Categories Affected] + &apos; (&apos; + [Visa Basis] + &apos;)&apos; END' />
            </column>
            <column caption='Source Link Text' datatype='string' name='[Calculation_3500000000000004]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([Source Link]) THEN &apos;View source&apos; END' />
            </column>
            <column caption='Impact' datatype='string' name='[Calculation_9100000000000001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Record Type] = &quot;baseline&quot; THEN &quot;Baseline&quot; ELSE [Impact Level] END' />
