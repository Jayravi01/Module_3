              <calculation class='tableau' formula='&quot;Last run &quot; + REPLACE(LEFT({ MAX([finished_at]) }, 16), &quot;T&quot;, &quot; &quot;) + &quot; · &quot; + STR({ FIXED : SUM(IF [finished_at] = { MAX([finished_at]) } THEN [changes_found] END) }) + &quot; changes found&quot; + &quot; · &quot; + STR({ FIXED : SUM(IF [finished_at] = { MAX([finished_at]) } THEN [sources_failed] END) }) + &quot; of &quot; + STR({ FIXED : SUM(IF [finished_at] = { MAX([finished_at]) } THEN [sources_checked] END) }) + &quot; sources unavailable&quot;' />
