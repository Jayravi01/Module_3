      <column caption='Latest Change Date' datatype='date' name='[Calculation_0333144164077568]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF [Record Type] = &quot;change&quot; THEN [Record Date] END) }' />
      </column>
      <column caption='Is Latest Change' datatype='boolean' name='[Calculation_0333144164155393]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Record Type] = &quot;change&quot; AND [Record Date] = [Calculation_0333144164077568]' />
      </column>
      <column caption='Changes Latest' datatype='integer' name='[Calculation_0333144164315138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0333144164155393] THEN 1 ELSE 0 END)' />
      </column>
      <column caption='High Latest' datatype='integer' name='[Calculation_0333144164401155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0333144164155393] AND [Impact Level] = &quot;High&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Medium Latest' datatype='integer' name='[Calculation_0333144164466692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0333144164155393] AND [Impact Level] = &quot;Medium&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Low Latest' datatype='integer' name='[Calculation_0333144164515845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0333144164155393] AND [Impact Level] = &quot;Low&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Change Type Label' datatype='string' name='[Calculation_0333144175501319]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Change Type]&#10;WHEN &quot;processing_time&quot;  THEN &quot;Processing time&quot;&#10;WHEN &quot;policy&quot;           THEN &quot;Policy&quot;&#10;WHEN &quot;health_insurance&quot; THEN &quot;Health insurance&quot;&#10;WHEN &quot;work_rights&quot;      THEN &quot;Work rights&quot;&#10;WHEN &quot;fees&quot;             THEN &quot;Fees&quot;&#10;ELSE [Change Type]&#10;END' />
      </column>
