            <run bold='true' fontcolor='#333333' fontname='Tableau Book' fontsize='16'>Source status</run>
            <run fontname='Tableau Book'>Æ&#10;</run>
            <run fontcolor='#7f7f7f' fontname='Tableau Book' fontsize='10'>Result of the last check of each of the 17 sources. Blocked sites are never bypassed. Click a row to open the page.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Source status (RDS)' name='federated.1m3srcstatus0visa0rds00000000' />
          </datasources>
          <datasource-dependencies datasource='federated.1m3srcstatus0visa0rds00000000'>
            <column caption='Checked On' datatype='string' name='[Calculation_3500000000000011]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Last Checked]) THEN &apos;-&apos; ELSE STR(YEAR([Last Checked])) + &apos;-&apos; + RIGHT(&apos;0&apos; + STR(MONTH([Last Checked])), 2) + &apos;-&apos; + RIGHT(&apos;0&apos; + STR(DAY([Last Checked])), 2) END' />
            </column>
            <column caption='Status Order' datatype='integer' name='[Calculation_3500000000000012]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Status] WHEN &apos;Scrape blocked&apos; THEN 1 WHEN &apos;Unavailable&apos; THEN 2 WHEN &apos;Not checked yet&apos; THEN 3 ELSE 4 END' />
            </column>
            <column datatype='date' name='[Last Checked]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Priority]' role='dimension' type='nominal' />
            <column datatype='string' name='[Source Link]' role='dimension' type='nominal' />
            <column datatype='string' name='[Source]' role='dimension' type='nominal' />
            <column datatype='string' name='[Status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3500000000000011]' derivation='None' name='[none:Calculation_3500000000000011:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3500000000000012]' derivation='None' name='[none:Calculation_3500000000000012:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Priority]' derivation='None' name='[none:Priority:nk]' pivot='key' type='nominal' />
            <column-instance column='[Source Link]' derivation='None' name='[none:Source Link:nk]' pivot='key' type='nominal' />
            <column-instance column='[Source]' derivation='None' name='[none:Source:nk]' pivot='key' type='nominal' />
            <column-instance column='[Status]' derivation='None' name='[none:Status:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
