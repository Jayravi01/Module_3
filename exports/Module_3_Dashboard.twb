            </column>
            <column caption='Visa (basis)' datatype='string' name='[Calculation_3500000000000003]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Visa Categories Affected]) OR [Visa Categories Affected] = &apos;&apos; THEN &apos;General&apos; ELSE [Visa Categories Affected] + &apos; (&apos; + [Visa Basis] + &apos;)&apos; END' />
            </column>
            <column caption='Source Link Text' datatype='string' name='[Calculation_3500000000000004]' role='dimension' type='nominal'>
