# Copy this file to ".env" (same folder) and fill it in. ".env" is excluded from Git.
# The DB_*, TUNNEL_* and ALERT_* lines are the SAME as Modules 1, 2 and 4: copy them from there.
# Keep comments on their own lines. Never put a password in a command or a URL.

# ---- Database (AWS RDS PostgreSQL) ----
# Leave DB_HOST empty to keep the history in the local file data/visa_monitor.db instead.
# On a laptop use DB_HOST=localhost and DB_PORT=5433 (the SSH tunnel below).
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=medibank
# DB_USER=
# DB_PASSWORD=
# DB_SSLMODE=require

# Module 3 tables live in their own schema, so intel (M1), pricing (M2) and
# partnership (M4) are never touched.
DB_SCHEMA=visa

# ---- SSH tunnel through the jumpbox (laptop:5433 -> jumpbox -> RDS:5432) ----
# TUNNEL_SSH_HOST=
# TUNNEL_SSH_USER=ec2-user
# TUNNEL_SSH_KEY=C:\Users\you\Downloads\medibank-jumpbox-key.pem
# TUNNEL_REMOTE_HOST=
# TUNNEL_ATTEMPTS=4
# TUNNEL_RETRY_WAIT_SECONDS=20

# ---- Alert email: the SAME ALERT_* lines as the other modules. Empty = preview files in logs\ ----
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_TO=
# ALERT_FROM=
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=465
# Lowest impact level that triggers an alert: High, Medium or Low
ALERT_MIN_LEVEL=Medium

# ---- Local AI (Ollama) for change summaries and impact ratings ----
# Install Ollama (https://ollama.com), then:  ollama pull qwen2.5:7b   (about 4.7 GB; ~30 s per change on a laptop)
# If Ollama is not running, changes are rated by the keyword rules instead.
USE_LLM=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=180

# ---- Scraping ----
REQUEST_TIMEOUT=30
POLITE_DELAY=2
ENABLE_JS_RENDER=true
TIMEZONE=Australia/Melbourne
